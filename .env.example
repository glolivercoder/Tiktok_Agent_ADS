# API Keys (não versionadas — veja scripts/import_keys.ps1)

# LLMs
OPENROUTER_API_KEY=
OMNIROUTE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# LLM routing (OmniRoute primeiro, OpenRouter fallback)
ECHOTIK_LLM_ENABLED=true
ECHOTIK_LLM_TIMEOUT=20
ECHOTIK_LLM_MAX_TOKENS=700
ECHOTIK_LLM_TEMPERATURE=0.4
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto/best-free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto

# Pesquisa / Dados
SERPAPI_API_KEY=
# EchoTik Data API — Autenticação Basic Auth (username:password)
# Obtenha suas credenciais em: https://echotik.live/platform/dashboard
# Não use aspas. Não nomeie como USER (evita conflito com variáveis do sistema).
ECHOTIK_BASE_URL=https://open.echotik.live
ECHOTIK_USERNAME=
ECHOTIK_PASSWORD=
ECHOTIK_REGION=BR
ECHOTIK_API_DAILY_LIMIT=50
ECHOTIK_API_TIMEOUT=15
TAVILY_API_KEY=
BRAVE_API_KEY=
LINKUP_API_KEY=
CONTEXT7_API_KEY=

# Embeddings (vazio = detecta Gemini/OpenAI pela chave; sem chave = hash local)
ECHOTIK_EMBED_PROVIDER=
ECHOTIK_EMBED_MODEL=
ECHOTIK_EMBED_DIM=384
ECHOTIK_EMBED_TIMEOUT=15

# Sidecar (gerado localmente)
ECHOTIK_AGENT_TOKEN=
ECHOTIK_CORS_ORIGINS=*
ECHOTIK_RATE_LIMIT_PER_MIN=120
ECHOTIK_RATE_LIMIT_BURST=30
# ECHOTIK_SKILLS_PATH=./data/skills/strategic_skills.json

# Hermes (opcional — URLs do monorepo local)
HERMES_SECRETS_URL=http://127.0.0.1:5011
HERMES_RESEARCH_URL=http://127.0.0.1:5021
HERMES_MARKET_URL=http://127.0.0.1:5022
HERMES_HTTP_TOKEN=
HERMES_HTTP_TIMEOUT=15
HERMES_MARKET_TIMEOUT=90

# Agency Agents (opcional — para seed de personas)
AGENCY_AGENTS_DIR=

# Apify — Web scraping de mercado (Mercado Livre, TikTok Shop)
# Obtenha seu token em: https://console.apify.com/account
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com
APIFY_WEBHOOK_SECRET=
# Atores Apify validados no painel (runs bem-sucedidas em 03/11/2026):
# Mercado Livre: piotrV1001/mercado-libre-listings-scraper — ~US$ 2 / 1.000 listings
# TikTok Shop:   clockworks/tiktok-shop-scraper — ~US$ 30 / 1.000 produtos (caro: piloto de 20 itens ≈ US$ 0,60; respeitar teto R4 de US$ 1/execução)
# Google Trends: apify/google-trends-scraper (candidato para sazonalidade BR — ainda sem run)
APIFY_ACTOR_MERCADO_LIVRE=
APIFY_ACTOR_TIKTOK=
APIFY_DATASET_MERCADO_LIVRE=
APIFY_DATASET_TIKTOK=
# Intervalo de atualização automática (segundos)
APIFY_REFRESH_INTERVAL=3600
