# API Keys (não versionadas — veja scripts/import_keys.ps1)

# LLMs
OPENROUTER_API_KEY=
OMNIROUTE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# LLM routing (OmniRoute primeiro, OpenRouter fallback)
ECHOTIK_LLM_ENABLED=true
ECHOTIK_LLM_TIMEOUT=20
ECHOTIK_LLM_MAX_TOKENS=700
ECHOTIK_LLM_TEMPERATURE=0.4
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto/best-free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto

# Pesquisa / Dados
SERPAPI_API_KEY=
# EchoTok Data API usa Basic auth. Prefira usuário/senha; a chave única
# também é aceita (vira "chave:" ou "user:pass" se contiver dois-pontos).
ECHOTOK_API_KEY=
ECHOTOK_API_USER=
ECHOTOK_API_PASSWORD=
ECHOTIK_API_BASE_URL=https://open.echotik.live/api/v3
ECHOTIK_REGION=BR
ECHOTIK_API_DAILY_LIMIT=50
ECHOTIK_API_TIMEOUT=15
TAVILY_API_KEY=
BRAVE_API_KEY=
LINKUP_API_KEY=
CONTEXT7_API_KEY=

# Embeddings (vazio = detecta Gemini/OpenAI pela chave; sem chave = hash local)
ECHOTIK_EMBED_PROVIDER=
ECHOTIK_EMBED_MODEL=
ECHOTIK_EMBED_DIM=384
ECHOTIK_EMBED_TIMEOUT=15

# Sidecar (gerado localmente)
ECHOTIK_AGENT_TOKEN=
ECHOTIK_CORS_ORIGINS=*
ECHOTIK_RATE_LIMIT_PER_MIN=120
ECHOTIK_RATE_LIMIT_BURST=30
# ECHOTIK_SKILLS_PATH=./data/skills/strategic_skills.json

# Hermes (opcional — URLs do monorepo local)
HERMES_SECRETS_URL=http://127.0.0.1:5011
HERMES_RESEARCH_URL=http://127.0.0.1:5021
HERMES_MARKET_URL=http://127.0.0.1:5022
HERMES_HTTP_TOKEN=
HERMES_HTTP_TIMEOUT=15

# Agency Agents (opcional — para seed de personas)
AGENCY_AGENTS_DIR=
